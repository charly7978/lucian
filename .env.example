# Podés usar Ajustes de Lucian o configurar estas variables como secretos del entorno.
# Elegí gmail, resend, webhook o manual según tu instalación.
LUCIAN_EMAIL_PROVIDER=manual
LUCIAN_GMAIL_USER=
LUCIAN_GMAIL_APP_PASSWORD=
LUCIAN_RESEND_KEY=
LUCIAN_EMAIL_FROM=
LUCIAN_EMAIL_REPLY_TO=
LUCIAN_EMAIL_FOOTER=

LUCIAN_TELEGRAM_TOKEN=
LUCIAN_TELEGRAM_CHAT_ID=
# Si querés pausar Telegram aunque haya un token y un chat, usá 0.
# LUCIAN_TELEGRAM_ENABLED=0

# Conservá el proveedor de IA y el modelo que hayas comprobado en Ajustes.
LUCIAN_AI_PROVIDER=
LUCIAN_AI_API_KEY=
LUCIAN_AI_BASE_URL=
LUCIAN_AI_MODEL=
