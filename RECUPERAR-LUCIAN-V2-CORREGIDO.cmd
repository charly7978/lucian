@echo off
setlocal
TITLE LUCIAN - RECUPERACION SEGURA V2
set "LUCIAN_TARGET=%~dp0"
where node >nul 2>nul
if errorlevel 1 (
  echo ERROR: Node.js no encontrado. Necesitas Node.js 20 o superior.
  pause
  exit /b 1
)
node -e "const fs=require('node:fs'); const src=fs.readFileSync(process.argv[1],'utf8'); const marker='REM DATA-INICIO'; const m=src.lastIndexOf('\n'+marker+'\n'); const m2=src.lastIndexOf('\r\n'+marker+'\r\n'); const start=m2>=0?m2+marker.length+4:(m>=0?m+marker.length+2:-1); if(start<0){console.error('No se encontro el codigo interno.');process.exit(1);} import('data:text/javascript;base64,'+src.slice(start).replace(/\s+/g,'')).catch(e=>{console.error(e);process.exitCode=1;})" "%~f0"
set "RC=%ERRORLEVEL%"
echo.
if "%RC%"=="0" (
 echo Operacion terminada. Abri INICIAR-LUCIAN.cmd de esta carpeta.
) else (
 echo La recuperacion no pudo completarse. Tu carpeta original no se borro.
)
echo.
pause
exit /b %RC%
