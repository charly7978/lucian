@echo off
setlocal
TITLE LUCIAN - RECUPERAR MIS DATOS SIN DUPLICAR
set "LUCIAN_TARGET=%~dp0"
if not exist "%LUCIAN_TARGET%server.mjs" (
  echo ERROR: Este archivo debe estar al lado del INICIAR-LUCIAN.cmd que funciona.
  echo Copialo a esa misma carpeta y ejecutalo de nuevo.
  pause
  exit /b 1
)
where node >nul 2>nul
if errorlevel 1 (
  echo ERROR: No se encontro Node.js. Se necesita Node.js 20 o superior.
  pause
  exit /b 1
)
echo.
echo Se buscara el trabajo anterior y se integrara en esta misma instalacion.
echo No se crea otra copia del programa.
echo.
node -e "const f=require('node:fs');const s=f.readFileSync(process.argv[1],'utf8');const m=s.match(/REM DATA-INICIO\r?\n([\s\S]*)$/);if(!m){console.error('Archivo incompleto');process.exit(1)}import('data:text/javascript;base64,'+m[1].replace(/\s+/g,'')).catch(e=>{console.error(e.message);process.exitCode=1})" "%~f0"
set "RC=%ERRORLEVEL%"
echo.
if "%RC%"=="0" echo Ahora inicia LUCIAN con el INICIAR-LUCIAN.cmd de esta misma carpeta.
if not "%RC%"=="0" echo Los datos originales siguen guardados; no los borres.
echo.
pause
exit /b %RC%
